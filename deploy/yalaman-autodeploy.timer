# Runs the autodeploy check shortly after boot and then every minute.
# systemd will not start a new run while the previous oneshot is still active,
# so deploys never overlap. See deploy/AUTODEPLOY.md.
[Unit]
Description=Run Yalaman Baby autodeploy check every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s
Unit=yalaman-autodeploy.service

[Install]
WantedBy=timers.target
