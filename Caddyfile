# Internal Caddy serves the static site behind the VPS's public reverse proxy.
#
# The public Caddy that already owns ports 80/443 should handle domains,
# redirects, and HTTPS, then proxy this app at yalaman-baby:80 or localhost:8088.

:80 {
	# ── Login that's remembered ──────────────────────────────────
	# You log in ONCE at /unlock (shared password). On success Caddy
	# plants a long-lived cookie, so the same browser stays logged in
	# for a year and never re-prompts — even after you close it.
	#
	# Deny-by-default: anything without the valid cookie is bounced to
	# /unlock. Only requests carrying the secret cookie reach the site.
	#
	# IMPORTANT: both secrets are injected from the environment, NOT stored
	# in this (public) repo:
	#   BABY_AUTH_HASH    — bcrypt hash of the shared password
	#   BABY_AUTH_COOKIE  — long random cookie secret
	# If either were committed here, anyone reading the repo could forge the
	# cookie and bypass the password entirely. See DEPLOY.md.
	#
	# Generate new values:
	#   docker run --rm caddy caddy hash-password --plaintext 'yourpass'   # BABY_AUTH_HASH
	#   openssl rand -hex 32                                               # BABY_AUTH_COOKIE
	# Rotate by changing the secrets and redeploying.

	# 1) /unlock — ask for the password, then set the year-long cookie.
	@unlock path /unlock
	handle @unlock {
		basic_auth {
			yalaman {$BABY_AUTH_HASH}
		}
		header +Set-Cookie "babyauth={$BABY_AUTH_COOKIE}; Path=/; Max-Age=31536000; HttpOnly; Secure; SameSite=Lax"
		redir / 302
	}

	# 2) No valid cookie → go log in. (Defined before the content handlers so
	#    unauthenticated requests are redirected on every path.)
	@noauth not header_regexp Cookie "babyauth={$BABY_AUTH_COOKIE}"
	handle @noauth {
		redir /unlock 302
	}

	# 3) Personal photos, mounted at runtime (see docker-compose PHOTOS_DIR).
	#    Served with a browsable JSON listing the Gallery page reads.
	handle /photos/* {
		root * /srv
		file_server browse
	}

	# 4) Logged-in browsers get the site.
	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server

		# Light caching so a redeploy shows new content within a minute.
		header /*.html Cache-Control "public, max-age=60"
	}
}
