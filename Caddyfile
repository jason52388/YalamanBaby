# Internal Caddy serves the static site behind the VPS's public reverse proxy.
#
# The public Caddy that already owns ports 80/443 should handle domains,
# redirects, and HTTPS, then proxy this app at yalaman-baby:80 or localhost:8088.

:80 {
	root * /srv
	encode gzip

	# ── Login that's remembered ──────────────────────────────────
	# You log in ONCE at /unlock (shared password). On success Caddy plants a
	# long-lived cookie, so the same browser stays logged in for a year.
	#
	# Deny-by-default: only requests carrying the valid cookie reach the site
	# (handler 2); everything else falls through to handler 3 and is bounced to
	# /unlock.
	#
	# IMPORTANT: both secrets are injected from the environment, NOT stored in
	# this (public) repo:
	#   BABY_AUTH_HASH    — bcrypt hash of the shared password
	#   BABY_AUTH_COOKIE  — long random cookie secret
	# If either were committed here, anyone reading the repo could forge the
	# cookie and bypass the password entirely. See DEPLOY.md.
	#
	# Generate new values:
	#   docker run --rm caddy caddy hash-password --plaintext 'yourpass'   # BABY_AUTH_HASH
	#   openssl rand -hex 32                                               # BABY_AUTH_COOKIE
	# Rotate by changing the secrets and redeploying.

	# 1) /unlock — ask for the password; ONLY on success set the year-long
	#    cookie and send the browser home.
	#
	#    Wrapped in `route` so directive order is PRESERVED: basic_auth runs
	#    first and halts with 401 on a missing/wrong password, so the
	#    Set-Cookie below is never reached unless authentication passed. In a
	#    plain `handle`, Caddy reorders directives and `header` ran BEFORE
	#    `basic_auth`, planting the auth cookie on the 401 response — i.e. a
	#    full password bypass (visiting /unlock once logged you in).
	#
	#    The cookie is planted on a 200 page that then redirects client-side —
	#    NOT on a 302. A Set-Cookie that rides on a redirect response is dropped
	#    by some browsers (notably Safari/iOS), which then followed the 302 to /
	#    with no cookie, got bounced back here, and were prompted for the
	#    password a SECOND time. (A 3xx also isn't cached as a basic-auth success,
	#    so that re-prompt showed a fresh dialog instead of silently reusing the
	#    credentials.) Setting the cookie on a real 200 makes the login stick on
	#    the first try.
	handle /unlock {
		route {
			basic_auth {
				yalaman {$BABY_AUTH_HASH}
			}
			header +Set-Cookie "babyauth={$BABY_AUTH_COOKIE}; Path=/; Max-Age=31536000; HttpOnly; Secure; SameSite=Lax"
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=/"><title>Unlocking…</title><body style="font-family:system-ui,sans-serif;text-align:center;margin-top:3rem;color:#555">Signing you in… <a href="/">continue</a>.</body>` 200
		}
	}

	# 2) Valid cookie → serve the site. Photos get a browsable JSON listing
	#    (read by the Gallery page); everything else is the SPA, with unknown
	#    paths falling back to index.html.
	@authed header_regexp Cookie "babyauth={$BABY_AUTH_COOKIE}"
	handle @authed {
		handle /photos/* {
			file_server browse
		}
		# Photo uploads go to the gated uploader service. Because this is inside
		# the @authed block, only requests carrying the valid cookie reach it.
		handle /api/* {
			reverse_proxy yalaman-uploader:8080
		}
		handle {
			try_files {path} /index.html
			file_server
			# Light caching so a redeploy shows new content within a minute.
			header /*.html Cache-Control "public, max-age=60"
		}
	}

	# 3) No valid cookie (and not /unlock) → go log in.
	#
	#    The redirect target is an ABSOLUTE URL on purpose. `redir /unlock 302`
	#    is mis-parsed by Caddy as "redirect requests matching path /unlock to
	#    the URL 302" — the leading slash is read as an inline path matcher and
	#    302 becomes the (bogus) destination. That left cookie-less requests to
	#    / matching nothing, so Caddy returned a blank 200 instead of bouncing
	#    here. An absolute URL can't be mistaken for a path matcher.
	handle {
		redir https://{host}/unlock 302
	}
}
