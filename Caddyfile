# Internal Caddy serves the static site behind the VPS's public reverse proxy.
#
# The public Caddy that already owns ports 80/443 should handle domains,
# redirects, and HTTPS, then proxy this app at yalaman-baby:80 or localhost:8088.

:80 {
	# ── Login that's remembered ──────────────────────────────────
	# You log in ONCE at /unlock (shared password). On success Caddy
	# plants a long-lived cookie, so the same browser stays logged in
	# for a year and never re-prompts — even after you close it.
	#
	# Security: the password is only stored as a bcrypt hash, and the
	# cookie holds a long random secret (HttpOnly, so page scripts
	# can't read it). Rotate either by changing the values below.
	#
	# New password hash:
	#   docker run --rm caddy caddy hash-password --plaintext 'yourpass'

	# A browser is "logged in" once it carries this secret cookie.
	@authed header_regexp Cookie "babyauth=9adac9ba34d0f1cc55cf60a5fef0d29ad5f7e3a4dc73f6f4d2c41c2f7626c5be"

	# /unlock — ask for the password, then set the year-long cookie.
	# `route` keeps these steps in order: reject first, set cookie only
	# after a correct password, then bounce to the home page.
	@unlock path /unlock
	handle @unlock {
		route {
			basic_auth {
				yalaman $2b$12$PdaLRfTeTHaWWm4czrIDRu6tvoD3iYuMIrvFsyFSKOkwMUF3B7obu
			}
			header +Set-Cookie "babyauth=9adac9ba34d0f1cc55cf60a5fef0d29ad5f7e3a4dc73f6f4d2c41c2f7626c5be; Path=/; Max-Age=31536000; HttpOnly; Secure; SameSite=Lax"
			redir / 302
		}
	}

	# Logged-in browsers get the site.
	handle @authed {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server

		# Light caching so a redeploy shows new content within a minute.
		header /*.html Cache-Control "public, max-age=60"
	}

	# Everyone else → go log in.
	handle {
		redir /unlock 302
	}
}
