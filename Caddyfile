# Caddy serves the static site and auto-provisions Let's Encrypt HTTPS.
#
# Hostnames are HARDCODED (not {$SITE_HOSTNAME}) — matching the stock-site
# setup — so an empty/missing env var can never produce an invalid empty site
# address that crashes Caddy. Both apex and www must have DNS A records
# pointing at this VPS for HTTPS to succeed (Let's Encrypt needs both).

# Bare domain -> redirect to www (canonical), preserving path/query.
yalamanbaby.com {
	redir https://www.yalamanbaby.com{uri} permanent
}

# www -> the actual site.
www.yalamanbaby.com {
	root * /srv
	encode gzip
	try_files {path} /index.html
	file_server

	# Light caching so a redeploy shows new content within a minute.
	header /*.html Cache-Control "public, max-age=60"
}
