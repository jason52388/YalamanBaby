# Copy to .env on the VPS (the deploy workflow writes SITE_HOSTNAME/BABY_HTTP_PORT
# automatically from GitHub secrets, and passes the auth secrets straight into
# the deploy shell). `chmod 600 .env`.

# ---- Public website ----
# Hostname for DNS / the PUBLIC Caddy that fronts this app. This internal Caddy
# listens on :80 and does not use the hostname itself, so nothing here needs to
# match the Caddyfile — set it for the public proxy + DNS docs only.
SITE_HOSTNAME=www.yalamanbaby.com

# Local-only port published on the VPS for the public Caddy to reverse proxy.
BABY_HTTP_PORT=8088

# ---- Auth gate secrets (REQUIRED) ----
# Injected into the Caddyfile via {$VAR}. NEVER commit real values — the repo
# is public, and a leaked cookie secret bypasses the password entirely.
#   BABY_AUTH_HASH   = docker run --rm caddy caddy hash-password --plaintext 'yourpass'
#   BABY_AUTH_COOKIE = openssl rand -hex 32
BABY_AUTH_HASH=
BABY_AUTH_COOKIE=

# ---- Photos (optional) ----
# Absolute host path holding the Gallery's personal photos. Mounted read-only
# at /srv/photos. Defaults to /srv/yalaman-photos if unset.
PHOTOS_DIR=/srv/yalaman-photos
