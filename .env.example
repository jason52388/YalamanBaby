# Copy to .env on the VPS (the deploy workflow writes this automatically from
# the SITE_HOSTNAME GitHub secret). `chmod 600 .env`.

# ---- Public website ----
# Hostname Caddy serves. Must resolve publicly for HTTPS to work
# (Let's Encrypt needs to reach :80). The live hostname is also hardcoded in
# the Caddyfile — keep the two in sync.
SITE_HOSTNAME=www.yalamanbaby.com

# Local-only port published on the VPS for the public Caddy to reverse proxy.
BABY_HTTP_PORT=8088
